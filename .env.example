# Development environment variable template.
# Copy to .env locally and provide values there. Never commit real secrets.

APP_ENV=development
APP_NAME=A-TECH Corporation
APP_HOST=127.0.0.1
APP_PORT=8000

# Database connection (configure only when the database service is implemented)
DATABASE_URL=

# Authentication and session secrets (generate secure values locally)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional integrations — leave unset until separately approved
GITHUB_TOKEN=
